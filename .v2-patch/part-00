@@ -0,0 +1,36 @@
+name: Signed release
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: android-actions/setup-android@v3
+      - uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: '8.10.2'
+      - run: sdkmanager "platforms;android-35" "build-tools;35.0.0"
+      - name: Restore upload key
+        env:
+          KEYSTORE_B64: ${{ secrets.LIBRE_UPLOAD_KEYSTORE_B64 }}
+        run: echo "$KEYSTORE_B64" | base64 --decode > "$RUNNER_TEMP/upload.jks"
+      - name: Build
+        env:
+          LIBRE_KEYSTORE_PATH: ${{ runner.temp }}/upload.jks
+          LIBRE_KEYSTORE_PASSWORD: ${{ secrets.LIBRE_UPLOAD_STORE_PASSWORD }}
+          LIBRE_KEY_ALIAS: ${{ secrets.LIBRE_UPLOAD_KEY_ALIAS }}
+          LIBRE_KEY_PASSWORD: ${{ secrets.LIBRE_UPLOAD_KEY_PASSWORD }}
+        run: gradle --no-daemon clean testDebugUnitTest lintRelease assembleRelease bundleRelease
+      - uses: actions/upload-artifact@v4
+        with:
+          name: libre-remote-release
+          path: |
+            app/build/outputs/apk/release/*.apk
+            app/build/outputs/bundle/release/*.aab
