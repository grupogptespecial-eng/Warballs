+    fun createMacro(
+        name: String,
+        actions: List<RemoteAction> = listOf(RemoteAction.PlayPause)
+    ): RemoteMacro {
+        val normalizedActions = actions.distinct().take(12).ifEmpty { listOf(RemoteAction.PlayPause) }
+        val steps = buildList {
+            normalizedActions.forEachIndexed { index, action ->
+                add(MacroStep(MacroStepType.Command, action))
+                if (index < normalizedActions.lastIndex) add(MacroStep(MacroStepType.Delay, delayMs = 250))
+            }
+        }
+        val macro = RemoteMacro(
+            id = UUID.randomUUID().toString(),
+            name = name.trim().take(40).ifBlank { "Nova macro" },
+            steps = steps
+        )
+        val macros = preferences.saveMacro(macro)
+        _uiState.update { it.copy(macros = macros) }
+        return macro
+    }
+
+    fun saveMacro(macro: RemoteMacro) {
+        val macros = preferences.saveMacro(macro)
+        _uiState.update { it.copy(macros = macros) }
+    }
+
+    fun deleteMacro(id: String) {
+        if (_uiState.value.macroRunState.macroId == id) cancelMacro()
+        val macros = preferences.deleteMacro(id)
+        _uiState.update { it.copy(macros = macros) }
+    }
+
+    fun runMacro(macro: RemoteMacro) {
+        macroJob?.cancel()
+        macroJob = viewModelScope.launch(Dispatchers.IO) {
+            _uiState.update {
+                it.copy(
+                    showMacrosSheet = false,
+                    macroRunState = MacroRunState(
+                        macroId = macro.id,
+                        macroName = macro.name,
+                        totalSteps = macro.steps.size,
+                        running = true,
+                        message = "Iniciando ${macro.name}…"
+                    )
+                )
+            }
+            val runner = RemoteMacroRunner(object : RemoteMacroRunner.Host {
+                override fun isConnected(): Boolean = _uiState.value.connected
+
+                override suspend fun waitForConnection(): Boolean {
+                    if (_uiState.value.connected) return true
+                    val current = _uiState.value.currentDevice ?: return false
+                    connect(current, userInitiated = false)
+                    return withTimeoutOrNull(8_000) {
+                        connectedSignal.await()
+                        true
+                    } == true
+                }
+
+                override suspend fun send(action: RemoteAction): Boolean {
+                    val backend = activeBackend ?: return false
+                    if (!_uiState.value.connected) return false
+                    if (action == RemoteAction.Mute) {
+                        val target = !_uiState.value.muted
+                        _uiState.update { it.copy(muted = target) }
+                        backend.setMute(target)
+                    } else {
+                        backend.send(action)
+                    }
+                    return true
+                }
+
+                override suspend fun launchApp(appId: String): Boolean {
+                    val app = _uiState.value.apps.firstOrNull { it.id == appId } ?: return false
+                    activeBackend?.launchApp(app) ?: return false
+                    return true
+                }
+
+                override suspend fun switchInput(inputId: String): Boolean {
+                    val input = _uiState.value.inputs.firstOrNull { it.id == inputId } ?: return false
+                    activeBackend?.switchInput(input) ?: return false
+                    return true
+                }
+
+                override suspend fun insertText(text: String): Boolean {
+                    if (TvCapability.Keyboard !in _uiState.value.capabilities) return false
+                    activeBackend?.insertText(text) ?: return false
+                    return true
+                }
+
+                override fun onProgress(index: Int, total: Int, message: String) {
+                    _uiState.update { state ->
+                        state.copy(
+                            macroRunState = state.macroRunState.copy(
+                                stepIndex = index,
+                                totalSteps = total,
+                                running = true,
+                                message = message
+                            )
+                        )
+                    }
+                }
+            })
+            try {
+                val result = runner.execute(macro)
+                _uiState.update {
+                    it.copy(
+                        statusText = result.message,
+                        macroRunState = it.macroRunState.copy(running = false, message = result.message)
+                    )
+                }
+            } catch (_: CancellationException) {
+                _uiState.update {
+                    it.copy(macroRunState = MacroRunState(message = "Macro cancelada"), statusText = "Macro cancelada")
+                }
+            }
+        }
+    }
+
+    fun cancelMacro() {
+        macroJob?.cancel()
+        macroJob = null
+        _uiState.update { it.copy(macroRunState = MacroRunState(message = "Macro cancelada")) }
+    }
+
+    fun handleVoiceTranscript(transcript: String) {
+        when (val parsed = VoiceCommandParser.parse(transcript)) {
+            is ParsedVoiceCommand.Action -> {
+                send(parsed.action)
+                _uiState.update { it.copy(statusText = "Comando de voz: ${parsed.action.name}") }
+            }
+            is ParsedVoiceCommand.Macro -> {
+                val macro = _uiState.value.macros.firstOrNull {
+                    it.name.contains(parsed.query, ignoreCase = true) || it.id.contains(parsed.query, ignoreCase = true)
+                }
+                if (macro != null) runMacro(macro)
+                else _uiState.update { it.copy(statusText = "Macro não encontrada: ${parsed.query}") }
+            }
+            is ParsedVoiceCommand.Text -> {
+                sendText(parsed.value)
+                _uiState.update { it.copy(statusText = "Texto enviado por voz") }
+            }
+            is ParsedVoiceCommand.Unknown -> {
+                _uiState.update { it.copy(statusText = "Não entendi: ${parsed.original.take(80)}") }
+            }
+        }
+    }
