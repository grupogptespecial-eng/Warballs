index 0000000..9d6c740
--- /dev/null
+++ b/app/src/main/java/com/geronimo/controlelgwifi/LibreRemoteWidgetProvider.kt
@@ -0,0 +1,78 @@
+package com.geronimo.controlelgwifi
+
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.appwidget.AppWidgetProvider
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.widget.RemoteViews
+
+class LibreRemoteWidgetProvider : AppWidgetProvider() {
+    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
+        appWidgetIds.forEach { appWidgetManager.updateAppWidget(it, views(context)) }
+    }
+
+    companion object {
+        fun updateAll(context: Context) {
+            val manager = AppWidgetManager.getInstance(context)
+            val component = ComponentName(context, LibreRemoteWidgetProvider::class.java)
+            val ids = manager.getAppWidgetIds(component)
+            ids.forEach { manager.updateAppWidget(it, views(context)) }
+        }
+
+        private fun views(context: Context): RemoteViews {
+            val state = RemotePreferences(context).loadState()
+            return RemoteViews(context.packageName, R.layout.widget_remote).apply {
+                setTextViewText(R.id.widget_tv_name, state.currentDevice?.displayName ?: "Libre Remote")
+                setTextViewText(
+                    R.id.widget_tv_status,
+                    state.currentDevice?.let { "${it.platformLabel} • toque para abrir" } ?: "Nenhuma TV selecionada"
+                )
+                setOnClickPendingIntent(R.id.widget_open, openAppIntent(context))
+                setOnClickPendingIntent(R.id.widget_wake, wakeIntent(context, 10))
+                setOnClickPendingIntent(R.id.widget_volume_down, commandIntent(context, RemoteAction.VolumeDown, 11))
+                setOnClickPendingIntent(R.id.widget_mute, commandIntent(context, RemoteAction.Mute, 12))
+                setOnClickPendingIntent(R.id.widget_volume_up, commandIntent(context, RemoteAction.VolumeUp, 13))
+                setOnClickPendingIntent(R.id.widget_play_pause, commandIntent(context, RemoteAction.PlayPause, 14))
+            }
+        }
+
+        private fun openAppIntent(context: Context): PendingIntent {
+            val intent = Intent(context, MainActivity::class.java).apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+            }
+            return PendingIntent.getActivity(
+                context,
+                1,
+                intent,
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+            )
+        }
+
+        private fun commandIntent(context: Context, action: RemoteAction, requestCode: Int): PendingIntent {
+            val intent = Intent(context, RemoteCommandReceiver::class.java).apply {
+                this.action = RemoteCommandReceiver.ACTION_COMMAND
+                putExtra(RemoteCommandReceiver.EXTRA_COMMAND, action.name)
+            }
+            return PendingIntent.getBroadcast(
+                context,
+                requestCode,
+                intent,
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+            )
+        }
+
+        private fun wakeIntent(context: Context, requestCode: Int): PendingIntent {
+            val intent = Intent(context, RemoteCommandReceiver::class.java).apply {
+                action = RemoteCommandReceiver.ACTION_WAKE
+            }
+            return PendingIntent.getBroadcast(
+                context,
+                requestCode,
+                intent,
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+            )
+        }
+    }
+}
