 fun MoreControlsSheet(state: RemoteUiState, viewModel: RemoteViewModel) {
+    val context = LocalContext.current
     var text by remember { mutableStateOf("") }
+    var voiceStatus by remember { mutableStateOf("") }
+    val speechIntent = remember {
+        Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.getDefault().toLanguageTag())
+            putExtra(RecognizerIntent.EXTRA_PROMPT, "Diga um comando para a TV")
+            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
+        }
+    }
+    val speechLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.StartActivityForResult()
+    ) { result ->
+        if (result.resultCode == Activity.RESULT_OK) {
+            val transcript = result.data
+                ?.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS)
+                ?.firstOrNull()
+            if (!transcript.isNullOrBlank()) {
+                voiceStatus = "Entendido: $transcript"
+                viewModel.handleVoiceTranscript(transcript)
+            } else {
+                voiceStatus = "Nenhuma fala reconhecida"
+            }
+        }
+    }
+    val microphonePermission = rememberLauncherForActivityResult(
+        ActivityResultContracts.RequestPermission()
+    ) { granted ->
+        if (granted) runCatching { speechLauncher.launch(speechIntent) }
+            .onFailure { voiceStatus = "Reconhecimento de voz indisponível neste aparelho" }
+        else voiceStatus = "Permissão do microfone negada"
+    }
+    val startVoice = {
+        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED) {
+            runCatching { speechLauncher.launch(speechIntent) }
+                .onFailure { voiceStatus = "Reconhecimento de voz indisponível neste aparelho" }
+        } else {
+            microphonePermission.launch(Manifest.permission.RECORD_AUDIO)
+        }
+    }
