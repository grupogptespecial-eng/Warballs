+++ b/app/src/test/java/com/geronimo/controlelgwifi/NetworkAddressValidatorTest.kt
@@ -0,0 +1,22 @@
+package com.geronimo.controlelgwifi
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class NetworkAddressValidatorTest {
+    @Test
+    fun acceptsPrivateAddresses() {
+        assertTrue(NetworkAddressValidator.isLocalHost("192.168.1.2"))
+        assertTrue(NetworkAddressValidator.isLocalHost("10.0.0.8"))
+        assertTrue(NetworkAddressValidator.isLocalHost("172.20.4.5"))
+        assertTrue(NetworkAddressValidator.isLocalHost("fe80::1"))
+    }
+
+    @Test
+    fun rejectsPublicAddresses() {
+        assertFalse(NetworkAddressValidator.isLocalHost("8.8.8.8"))
+        assertFalse(NetworkAddressValidator.isLocalHost("1.1.1.1"))
+        assertFalse(NetworkAddressValidator.isLocalHost("example.com"))
+    }
+}
diff --git a/app/src/test/java/com/geronimo/controlelgwifi/PerformanceTrackerTest.kt b/app/src/test/java/com/geronimo/controlelgwifi/PerformanceTrackerTest.kt
new file mode 100644
index 0000000..3b4ba01
--- /dev/null
+++ b/app/src/test/java/com/geronimo/controlelgwifi/PerformanceTrackerTest.kt
@@ -0,0 +1,28 @@
+package com.geronimo.controlelgwifi
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PerformanceTrackerTest {
+    @Test
+    fun keepsBoundedWindowAndComputesPercentile() {
+        val tracker = PerformanceTracker(maxSamples = 5)
+        (1..10).forEach { tracker.recordCommandDispatch(it.toDouble()) }
+        tracker.recordConnection(320)
+
+        val snapshot = tracker.snapshot()
+        assertEquals(5, snapshot.commandSampleCount)
+        assertEquals(8.0, snapshot.averageCommandDispatchMs ?: 0.0, 0.001)
+        assertEquals(10.0, snapshot.p95CommandDispatchMs ?: 0.0, 0.001)
+        assertEquals(320L, snapshot.lastConnectionMs)
+    }
+
+    @Test
+    fun ignoresInvalidSamples() {
+        val tracker = PerformanceTracker()
+        tracker.recordCommandDispatch(Double.NaN)
+        tracker.recordCommandDispatch(-1.0)
+        assertTrue(tracker.snapshot().commandSampleCount == 0)
+    }
+}
diff --git a/app/src/test/java/com/geronimo/controlelgwifi/PresetCodecTest.kt b/app/src/test/java/com/geronimo/controlelgwifi/PresetCodecTest.kt
