+private fun MacroStep.shortLabel(): String = when (type) {
+    MacroStepType.Command -> action?.displayLabel() ?: "Comando"
+    MacroStepType.Delay -> "${delayMs} ms"
+    MacroStepType.WaitForConnection -> "Conectar"
+    MacroStepType.LaunchApp -> "App"
+    MacroStepType.SwitchInput -> "Entrada"
+    MacroStepType.InsertText -> "Texto"
+}
+
+private fun RemoteAction.displayLabel(): String = when (this) {
+    RemoteAction.Up -> "Cima"
+    RemoteAction.Down -> "Baixo"
+    RemoteAction.Left -> "Esquerda"
+    RemoteAction.Right -> "Direita"
+    RemoteAction.Enter -> "OK"
+    RemoteAction.Back -> "Voltar"
+    RemoteAction.Home -> "Home"
+    RemoteAction.Menu -> "Menu"
+    RemoteAction.Settings -> "Ajustes"
+    RemoteAction.Info -> "Info"
+    RemoteAction.Guide -> "Guia"
+    RemoteAction.Exit -> "Sair"
+    RemoteAction.VolumeUp -> "Volume +"
+    RemoteAction.VolumeDown -> "Volume −"
+    RemoteAction.Mute -> "Mudo"
+    RemoteAction.ChannelUp -> "Canal +"
+    RemoteAction.ChannelDown -> "Canal −"
+    RemoteAction.Play -> "Play"
+    RemoteAction.Pause -> "Pausa"
+    RemoteAction.PlayPause -> "Play/Pausa"
+    RemoteAction.Rewind -> "Voltar mídia"
+    RemoteAction.FastForward -> "Avançar mídia"
+    RemoteAction.Stop -> "Parar"
+    RemoteAction.Previous -> "Anterior"
+    RemoteAction.Next -> "Próximo"
+    RemoteAction.PowerOff -> "Desligar"
+}
+
