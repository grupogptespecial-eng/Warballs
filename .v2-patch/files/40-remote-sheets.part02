+                FlowRow(horizontalArrangement = Arrangement.spacedBy(7.dp), verticalArrangement = Arrangement.spacedBy(7.dp)) {
+                    availableActions.forEach { action ->
+                        FilterChip(
+                            selected = action in selectedActions,
+                            onClick = {
+                                selectedActions = if (action in selectedActions) selectedActions - action else selectedActions + action
+                            },
+                            label = { Text(action.displayLabel()) }
+                        )
+                    }
+                }
+                Spacer(Modifier.height(10.dp))
+                Button(
+                    onClick = {
+                        viewModel.createMacro(newName, availableActions.filter(selectedActions::contains))
+                        newName = ""
+                        selectedActions = setOf(RemoteAction.PlayPause)
+                    },
+                    enabled = newName.isNotBlank() && selectedActions.isNotEmpty(),
+                    modifier = Modifier.fillMaxWidth()
+                ) {
+                    Icon(Icons.Rounded.Save, contentDescription = null)
+                    Spacer(Modifier.width(7.dp))
+                    Text("Salvar macro")
+                }
+            }
+        }
+    }
+
+    pendingConfirmation?.let { macro ->
+        AlertDialog(
+            onDismissRequest = { pendingConfirmation = null },
+            title = { Text("Executar ${macro.name}?") },
+            text = { Text("Esta macro inclui uma ação de desligamento. Confira se selecionou a TV correta.") },
+            confirmButton = {
+                Button(onClick = {
+                    pendingConfirmation = null
+                    viewModel.runMacro(macro)
+                }) { Text("Executar") }
+            },
+            dismissButton = { TextButton(onClick = { pendingConfirmation = null }) { Text("Cancelar") } }
+        )
+    }
+}
