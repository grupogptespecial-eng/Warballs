+    private fun loadMacros(): List<RemoteMacro> {
+        val defaults = RemoteMacro.defaults()
+        val raw = prefs.getString("macros", null) ?: return defaults
+        val loaded = runCatching {
+            val array = JSONArray(raw)
+            buildList {
+                for (index in 0 until array.length()) {
+                    val item = array.optJSONObject(index) ?: continue
+                    val id = item.optString("id").takeIf(String::isNotBlank) ?: continue
+                    val stepsJson = item.optJSONArray("steps") ?: JSONArray()
+                    val steps = buildList {
+                        for (stepIndex in 0 until stepsJson.length()) {
+                            val step = stepsJson.optJSONObject(stepIndex) ?: continue
+                            val type = enumValueOrDefault(
+                                step.optString("type").takeIf(String::isNotBlank),
+                                MacroStepType.Command
+                            )
+                            val action = step.optString("action").takeIf(String::isNotBlank)?.let {
+                                runCatching { RemoteAction.valueOf(it) }.getOrNull()
+                            }
+                            add(
+                                MacroStep(
+                                    type = type,
+                                    action = action,
+                                    value = step.optString("value").takeIf(String::isNotBlank),
+                                    delayMs = step.optLong("delayMs", 0L),
+                                    timeoutMs = step.optLong("timeoutMs", 5_000L),
+                                    continueOnError = step.optBoolean("continueOnError", false)
+                                )
+                            )
+                        }
+                    }
+                    if (steps.isEmpty()) continue
+                    add(
+                        RemoteMacro(
+                            id = id,
+                            name = item.optString("name", "Macro"),
+                            steps = steps,
+                            builtIn = item.optBoolean("builtIn", false),
+                            favorite = item.optBoolean("favorite", false),
+                            requiresConfirmation = item.optBoolean("requiresConfirmation", false)
+                        )
+                    )
+                }
+            }
+        }.getOrDefault(emptyList())
+        val merged = (loaded + defaults.filter { default -> loaded.none { it.id == default.id } })
+        return merged.distinctBy(RemoteMacro::id)
+    }
+
+    private fun macrosToJson(macros: List<RemoteMacro>): JSONArray = JSONArray().apply {
+        macros.forEach { macro ->
+            put(
+                JSONObject()
+                    .put("id", macro.id)
+                    .put("name", macro.name)
+                    .put("builtIn", macro.builtIn)
+                    .put("favorite", macro.favorite)
+                    .put("requiresConfirmation", macro.requiresConfirmation)
+                    .put("steps", JSONArray().apply {
+                        macro.steps.forEach { step ->
+                            put(
+                                JSONObject()
+                                    .put("type", step.type.name)
+                                    .put("action", step.action?.name ?: "")
+                                    .put("value", step.value ?: "")
+                                    .put("delayMs", step.delayMs)
+                                    .put("timeoutMs", step.timeoutMs)
+                                    .put("continueOnError", step.continueOnError)
+                            )
+                        }
+                    })
+            )
+        }
+    }
+
