+    fun saveMacro(macro: RemoteMacro): List<RemoteMacro> {
+        val normalized = macro.copy(
+            id = macro.id.ifBlank { UUID.randomUUID().toString() },
+            name = macro.name.trim().take(40).ifBlank { "Nova macro" },
+            steps = macro.steps.take(40)
+        )
+        val updated = (loadMacros().filterNot { it.id == normalized.id } + normalized)
+            .sortedWith(compareByDescending<RemoteMacro> { it.favorite }.thenBy { it.name.lowercase() })
+            .take(40)
+        prefs.edit().putString("macros", macrosToJson(updated).toString()).apply()
+        return updated
+    }
+
+    fun deleteMacro(id: String): List<RemoteMacro> {
+        val existing = loadMacros()
+        val defaults = RemoteMacro.defaults().associateBy(RemoteMacro::id)
+        val updated = existing.mapNotNull { macro ->
+            when {
+                macro.id != id -> macro
+                macro.builtIn -> defaults[id]
+                else -> null
+            }
+        }
+        prefs.edit().putString("macros", macrosToJson(updated).toString()).apply()
+        return updated
+    }
+
