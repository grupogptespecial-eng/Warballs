ge.resolved(): AppLanguage = when (this) {
+    AppLanguage.System -> when (Locale.getDefault().language.lowercase(Locale.ROOT)) {
+        "en" -> AppLanguage.English
+        "es" -> AppLanguage.Spanish
+        else -> AppLanguage.Portuguese
+    }
+    else -> this
+}
+
+fun AppLanguage.t(pt: String, en: String, es: String): String = when (resolved()) {
+    AppLanguage.English -> en
+    AppLanguage.Spanish -> es
+    else -> pt
+}
+
+fun AppLanguage.voiceTag(): String = when (resolved()) {
+    AppLanguage.English -> "en-US"
+    AppLanguage.Spanish -> "es-ES"
+    else -> "pt-BR"
+}
+
+fun AppLanguage.label(): String = when (this) {
+    AppLanguage.System -> t("Sistema", "System", "Sistema")
+    AppLanguage.Portuguese -> "Português"
+    AppLanguage.English -> "English"
+    AppLanguage.Spanish -> "Español"
+}
+
+fun RemotePresetId.localizedTitle(language: AppLanguage): String = when (this) {
+    RemotePresetId.Simple -> language.t("Simples", "Simple", "Simple")
+    RemotePresetId.Normal -> language.t("Normal", "Normal", "Normal")
+    RemotePresetId.Advanced -> language.t("Avançado", "Advanced", "Avanzado")
+    RemotePresetId.AdvancedLegacy -> language.t("Avançado AL", "Advanced AL", "Avanzado AL")
+    RemotePresetId.Custom1 -> language.t("Personalizado 1", "Custom 1", "Personalizado 1")
+    RemotePresetId.Custom2 -> language.t("Personalizado 2", "Custom 2", "Personalizado 2")
+    RemotePresetId.Custom3 -> language.t("Personalizado 3", "Custom 3", "Personalizado 3")
+}
+
+fun RemotePreset.localizedName(language: AppLanguage): String =
+    if (id.isCustom && name != id.title) name else id.localizedTitle(language)
+
+fun RemoteModule.localizedTitle(language: AppLanguage): String = when (this) {
+    RemoteModule.Power -> language.t("Energia", "Power", "Energía")
+    RemoteModule.DPad -> language.t("Navegação", "Navigation", "Navegación")
+    RemoteModule.Volume -> language.t("Volume", "Volume", "Volumen")
+    RemoteModule.Channels -> language.t("Canais", "Channels", "Canales")
+    RemoteModule.CoreActions -> language.t("Voltar, Home e Mudo", "Back, Home and Mute", "Volver, Home y Silencio")
+    RemoteModule.Media -> language.t("Reprodução", "Playback", "Reproducción")
+    RemoteModule.Apps -> language.t("Aplicativos", "Apps", "Aplicaciones")
+    RemoteModule.Inputs -> language.t("Entradas", "Inputs", "Entradas")
+    RemoteModule.Keyboard -> language.t("Teclado", "Keyboard", "Teclado")
+    RemoteModule.Numeric -> language.t("Teclado numérico", "Number pad", "Teclado numérico")
+    RemoteModule.Colors -> language.t("Botões coloridos", "Color buttons", "Botones de colores")
+    RemoteModule.InfoMenu -> language.t("Info e Menu", "Info and Menu", "Info y Menú")
+    RemoteModule.TouchpadShortcut -> language.t("Atalho do touchpad", "Touchpad shortcut", "Acceso al panel táctil")
+}
