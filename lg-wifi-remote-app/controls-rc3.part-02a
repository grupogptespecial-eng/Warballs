+    val speechLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.StartActivityForResult()
+    ) { result ->
+        if (result.resultCode == Activity.RESULT_OK) {
+            val text = result.data
+                ?.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS)
+                ?.firstOrNull()
+                ?.trim()
+            if (!text.isNullOrBlank()) viewModel.sendText(text)
+        }
+    }
+    val startVoiceInput: () -> Unit = {
+        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE, state.appLanguage.voiceTag())
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE_PREFERENCE, state.appLanguage.voiceTag())
+            putExtra(RecognizerIntent.EXTRA_PROMPT, state.appLanguage.t(
+                "Fale o texto para enviar à TV",
+                "Speak the text to send to the TV",
+                "Di el texto que quieres enviar al televisor"
+            ))
+            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
+        }
+        runCatching { speechLauncher.launch(intent) }
+            .onFailure { viewModel.voiceUnavailable() }
+    }
