+        assertEquals("type:move\ndx:240\ndy:-240\ndown:0\n\n", LgPointerProtocol.move(999, -999))
+        assertEquals("type:scroll\ndx:0\ndy:80\n\n", LgPointerProtocol.scroll(999))
