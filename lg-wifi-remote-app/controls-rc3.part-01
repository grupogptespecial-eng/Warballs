-    MaterialTheme(
-        colorScheme = colors,
-        typography = Typography(),
-        content = content
-    )
+    CompositionLocalProvider(
+        LocalAnimationPreset provides animationPreset,
+        LocalButtonEffect provides buttonEffect,
+        LocalAppLanguage provides appLanguage
+    ) {
+        MaterialTheme(
+            colorScheme = colors,
+            typography = Typography(),
+            content = content
