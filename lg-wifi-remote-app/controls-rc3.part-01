+}
+
+@Composable
+fun AnimatedBackdrop(
+    modifier: Modifier = Modifier,
+    content: @Composable () -> Unit
+) {
+    val preset = LocalAnimationPreset.current
+    val background = MaterialTheme.colorScheme.background
+    if (preset == AnimationPreset.Off) {
+        Box(modifier.fillMaxSize().background(background)) { content() }
+        return
+    }
+
+    val duration = when (preset) {
+        AnimationPreset.Soft -> 20_000
+        AnimationPreset.Aurora -> 13_000
+        AnimationPreset.Pulse -> 7_000
+        AnimationPreset.Dynamic -> 9_000
+        AnimationPreset.Off -> 20_000
+    }
+    val transition = rememberInfiniteTransition(label = "background-motion")
+    val phase = transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(duration),
+            repeatMode = RepeatMode.Restart
+        ),
+        label = "background-phase"
+    ).value
+    val pulse = transition.animateFloat(
+        initialValue = 0.82f,
+        targetValue = 1.08f,
+        animationSpec = infiniteRepeatable(
+            animation = tween((duration * 0.55f).toInt()),
+            repeatMode = RepeatMode.Reverse
+        ),
+        label = "background-pulse"
+    ).value
+
+    val primary = MaterialTheme.colorScheme.primary
+    val tertiary = MaterialTheme.colorScheme.tertiary
+    Box(modifier.fillMaxSize().background(background)) {
+        Canvas(Modifier.fillMaxSize()) {
+            val dynamic = preset == AnimationPreset.Dynamic
+            val aurora = preset == AnimationPreset.Aurora
+            val amplitude = if (dynamic) 0.26f else 0.15f
+            val radiusBase = size.minDimension * if (aurora) 0.62f else 0.48f
+            fun wave(offset: Float): Float = kotlin.math.sin((phase * 6.283f + offset).toDouble()).toFloat()
+            val x1 = size.width * (0.25f + amplitude * wave(0f))
+            val y1 = size.height * (0.18f + 0.10f * wave(1.5f))
+            val x2 = size.width * (0.76f - amplitude * wave(0.8f))
+            val y2 = size.height * (0.72f + 0.12f * wave(2.2f))
+            drawCircle(
+                color = primary.copy(alpha = if (preset == AnimationPreset.Pulse) 0.13f * pulse else 0.10f),
+                radius = radiusBase * pulse,
+                center = Offset(x1, y1)
+            )
+            drawCircle(
+                color = tertiary.copy(alpha = if (aurora) 0.12f else 0.08f),
+                radius = radiusBase * 0.82f,
+                center = Offset(x2, y2)
+            )
+        }
+        content()
+    }
 }
