+        val encodedName = Base64.encodeToString("Libre Remote".toByteArray(), Base64.NO_WRAP)
+        val token = securePreferences.getString("samsung_token_${device.ip}", null)
+        val secure = buildString {
+            append("wss://${device.ip}:8002/api/v2/channels/samsung.remote.control?name=$encodedName")
+            if (!token.isNullOrBlank()) append("&token=$token")
+        }
