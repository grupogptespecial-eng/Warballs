+        listener.onConnectionState(
+            if (reconnectAttempt > 0) ConnectionState.Reconnecting else ConnectionState.Connecting,
+            if (reconnectAttempt > 0) "Reconectando à Samsung…" else "Conectando a ${device.displayName}…",
+            reconnectAttempt
+        )
