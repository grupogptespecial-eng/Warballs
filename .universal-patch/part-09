+            val discovered = variants.maxByOrNull(::priority) ?: variants.first()
+            val saved = knownDevices.firstOrNull {
+                it.stableId == discovered.stableId || (it.ip == discovered.ip && it.platform == discovered.platform)
+            } ?: knownDevices.firstOrNull { it.ip == discovered.ip && it.platform == TvPlatform.LgWebOs && discovered.platform == TvPlatform.LgWebOs }
+
+            val mergedData = buildMap {
