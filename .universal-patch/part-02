TROL_URL,
+            action = "GetVolume",
+            body = "<InstanceID>0</InstanceID><Channel>Master</Channel>"
+        )
+        return Regex("<(?:[A-Za-z0-9_]+:)?CurrentVolume>(\\d+)</", RegexOption.IGNORE_CASE)
+            .find(response)?.groupValues?.getOrNull(1)?.toIntOrNull()
+            ?: throw IllegalStateException("CurrentVolume ausente")
+    }
+
+    private fun getMuteInternal(): Boolean {
+        val response = soap(
+            serviceTypeKey = KEY_RENDERING_CONTROL_TYPE,
+            controlUrlKey = KEY_RENDERING_CONTROL_URL,
+            action = "GetMute",
+            body = "<InstanceID>0</InstanceID><Channel>Master</Channel>"
+        )
+        val raw = Regex("<(?:[A-Za-z0-9_]+:)?CurrentMute>([^<]+)</", RegexOption.IGNORE_CASE)
+            .find(response)?.groupValues?.getOrNull(1)?.trim()?.lowercase()
+            ?: throw IllegalStateException("CurrentMute ausente")
+        return raw == "1" || raw == "true"
+    }
+
+    private fun soap(
+        serviceTypeKey: String,
+        controlUrlKey: String,
+        action: String,
+        body: String
+    ): String {
+        val current = device ?: throw IllegalStateException("Nenhuma TV selecionada")
+        val serviceType = current.backendData[serviceTypeKey]
+            ?: throw IllegalStateException("Tipo de serviço ausente")
+        val controlUrl = current.backendData[controlUrlKey]
+            ?: throw IllegalStateException("URL de controle ausente")
+        require(isLocalHttpUrl(controlUrl)) { "URL DLNA fora da rede local" }
+
+        val envelope = buildSoapEnvelope(serviceType, action, body)
+        val connection = URL(controlUrl).openConnection() as HttpURLConnection
+        connection.requestMethod = "POST"
+        connection.connectTimeout = 1_200
+        connection.readTimeout = 1_800
+        connection.instanceFollowRedirects = false
+        connection.doOutput = true
+        connection.setRequestProperty("Content-Type", "text/xml; charset=\"utf-8\"")
+        connection.setRequestProperty("SOAPACTION", "\"$serviceType#$action\"")
+        connection.outputStream.use { it.write(envelope.toByteArray(Charsets.UTF_8)) }
+        val code = connection.responseCode
+        val stream = if (code in 200..299) connection.inputStream else connection.errorStream
+        val response = stream?.bufferedReader()?.use { it.readText().take(300_000) }.orEmpty()
+        if (code !in 200..299) throw IllegalStateException("DLNA HTTP $code")
+        return response
+    }
+
+    internal fun buildSoapEnvelope(serviceType: String, action: String, body: String): String =
+        "<?xml version=\"1.0\" encoding=\"utf-8\"?>" +
+            "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">" +
+            "<s:Body><u:$action xmlns:u=\"$serviceType\">$body</u:$action></s:Body></s:Envelope>"
+
+    override fun close() {
+        connected = false
+        listener.onConnectionState(ConnectionState.Idle, "Desconectada")
+    }
+
+    override fun forgetDevice(device: TvDevice) = Unit
+
+    private fun isLocalHttpUrl(value: String): Boolean = runCatching {
+        val url = URL(value)
+        if (url.protocol !in setOf("http", "https")) return@runCatching false
+        val address = java.net.InetAddress.getByName(url.host)
+        address.isSiteLocalAddress || address.isLinkLocalAddress || address.isLoopbackAddress
+    }.getOrDefault(false)
+
+    companion object {
+        const val KEY_AV_TRANSPORT_URL = "dlna.avTransport.controlUrl"
+        const val KEY_AV_TRANSPORT_TYPE = "dlna.avTransport.serviceType"
+        const val KEY_RENDERING_CONTROL_URL = "dlna.renderingControl.controlUrl"
+        const val KEY_RENDERING_CONTROL_TYPE = "dlna.renderingControl.serviceType"
+    }
+}
