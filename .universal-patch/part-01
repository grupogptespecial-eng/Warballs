+/**
+ * Standards-based UPnP AV / DLNA MediaRenderer backend.
+ *
+ * It controls the renderer's active media session. It does not navigate the TV UI,
+ * open arbitrary installed apps, or replace a full vendor remote protocol.
+ */
+class DlnaBackend(
+    context: Context,
