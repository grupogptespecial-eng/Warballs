+    override val metadata = TvBackendMetadata(
+        platform = TvPlatform.DlnaMedia,
+        supportLevel = TvSupportLevel.BetaMediaOnly,
+        displayName = "DLNA / UPnP AV",
+        accountRequired = false,
+        localOnly = true,
+        notes = "Controla transporte e volume da sessão de mídia anunciada pelo MediaRenderer."
+    )
+
+    override val defaultCapabilities: Set<TvCapability> = TvCapability.dlnaDefaults
+
+    override fun connect(device: TvDevice, userInitiated: Boolean) {
+        this.device = device
+        connected = false
+        listener.onConnectionState(
+            if (userInitiated) ConnectionState.Connecting else ConnectionState.Reconnecting,
+            "Conectando ao MediaRenderer de ${device.displayName}…"
+        )
+        scope.launch {
+            val hasTransport = device.backendData[KEY_AV_TRANSPORT_URL].isNullOrBlank().not()
+            val hasRendering = device.backendData[KEY_RENDERING_CONTROL_URL].isNullOrBlank().not()
+            if (!hasTransport && !hasRendering) {
+                listener.onConnectionState(ConnectionState.Error, "A TV anunciou DLNA, mas não informou serviços de controle.")
+                return@launch
+            }
+
+            val reachable = when {
+                hasRendering -> runCatching { getVolumeInternal() }.isSuccess
+                hasTransport -> runCatching { getTransportInfo() }.isSuccess
+                else -> false
+            }
+            if (!reachable) {
+                listener.onConnectionState(ConnectionState.Error, "A TV não respondeu aos comandos DLNA.")
+                return@launch
+            }
+
+            connected = true
+            val capabilities = buildSet {
+                add(TvCapability.DeviceInfo)
+                if (hasTransport) addAll(setOf(TvCapability.Media, TvCapability.Seek))
+                if (hasRendering) addAll(setOf(TvCapability.Volume, TvCapability.AbsoluteVolume))
+            }
+            listener.onCapabilities(capabilities)
+            listener.onApps(emptyList())
+            listener.onInputs(emptyList())
+            listener.onConnectionState(ConnectionState.Connected, "Conectada a ${device.displayName} em modo mídia")
+            refreshDeviceData()
+        }
+    }
+
+    override fun send(action: RemoteAction) {
+        if (!connected) return
+        when (action) {
+            RemoteAction.Play, RemoteAction.PlayPause -> transportAction("Play", "<Speed>1</Speed>")
+            RemoteAction.Pause -> transportAction("Pause")
+            RemoteAction.Stop -> transportAction("Stop")
+            RemoteAction.Previous -> transportAction("Previous")
+            RemoteAction.Next -> transportAction("Next")
+            RemoteAction.VolumeUp -> adjustVolume(2)
+            RemoteAction.VolumeDown -> adjustVolume(-2)
+            RemoteAction.Mute -> setMute(!lastMuted)
+            else -> Unit
+        }
+    }
+
+    override fun setMute(muted: Boolean) {
+        if (!connected) return
+        scope.launch {
+            runCatching {
+                soap(
+                    serviceTypeKey = KEY_RENDERING_CONTROL_TYPE,
+                    controlUrlKey = KEY_RENDERING_CONTROL_URL,
+                    action = "SetMute",
+                    body = "<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>${if (muted) 1 else 0}</DesiredMute>"
+                )
+            }.onSuccess {
+                lastMuted = muted
+                listener.onVolume(lastVolume, muted)
+            }
+        }
+    }
+
+    private fun adjustVolume(delta: Int) {
+        scope.launch {
+            val current = runCatching { getVolumeInternal() }.getOrElse { lastVolume ?: 20 }
