+                    action = "SetVolume",
+                    body = "<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>$target</DesiredVolume>"
+                )
+            }.onSuccess {
+                lastVolume = target
+                listener.onVolume(target, lastMuted)
+            }
+        }
+    }
+
+    private fun transportAction(action: String, extra: String = "") {
+        scope.launch {
+            runCatching {
+                soap(
+                    serviceTypeKey = KEY_AV_TRANSPORT_TYPE,
+                    controlUrlKey = KEY_AV_TRANSPORT_URL,
+                    action = action,
+                    body = "<InstanceID>0</InstanceID>$extra"
+                )
+            }.onFailure {
+                listener.onConnectionState(ConnectionState.Error, "A TV não aceitou o comando DLNA $action.")
+            }
+        }
+    }
+
+    override fun refreshDeviceData() {
+        if (!connected) return
+        scope.launch {
+            val volume = runCatching { getVolumeInternal() }.getOrNull()
+            val muted = runCatching { getMuteInternal() }.getOrNull()
+            if (volume != null) lastVolume = volume
+            if (muted != null) lastMuted = muted
+            listener.onVolume(lastVolume, lastMuted)
+        }
+    }
